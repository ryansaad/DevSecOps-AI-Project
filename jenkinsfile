pipeline {
    agent any

    tools {
        maven 'maven'
        jdk 'java-17'
    }

    environment {
        // Use a more reliable image name
        DOCKER_REPO = "ryansaad85/devops-pipeline"
        IMAGE_NAME = "${DOCKER_REPO}:${GIT_COMMIT}"
    }

    stages {
        stage('Git Checkout') {
            steps {
                git url: 'https://github.com/ryansaad/DevSecOps-AI-Project.git',
                    branch: 'main'
            }
        }

        stage('Compile & Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    // Force a clean build to ensure the /app/data permission fix is included
                    sh "docker build --no-cache -t ${IMAGE_NAME} ."
                    // Also tag as latest for easier manual debugging
                    sh "docker tag ${IMAGE_NAME} ${DOCKER_REPO}:latest"
                }
            }
        }

        stage('Docker Login & Push') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                        sh "echo ${PASS} | docker login -u ${USER} --password-stdin"
                        sh "docker push ${IMAGE_NAME}"
                        sh "docker push ${DOCKER_REPO}:latest"
                    }
                }
            }
        }

        stage('Update Kubeconfig') {
            steps {
                // Ensure the Jenkins agent has the AWS CLI and proper IAM permissions
                sh "aws eks update-kubeconfig --region us-east-1 --name quantam-cluster"
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig(
                    clusterName: 'quantam-cluster',
                    credentialsId: 'kube',
                    namespace: 'quantam',
                    serverUrl: 'https://1DC7A2B4166E0B7F019E7D1C4B537014.gr7.us-east-1.eks.amazonaws.com'
                ) {
                    sh '''
                        echo "Injecting image tag: ${GIT_COMMIT}"
                        
                        # Use double quotes for sed so Jenkins expands the variable
                        # Ensure deployment.yaml has: image: ryansaad85/devops-pipeline:IMAGE_PLACEHOLDER
                        sed -i "s|IMAGE_PLACEHOLDER|${GIT_COMMIT}|g" deployment.yaml
                        
                        kubectl apply -f deployment.yaml -n quantam
                        
                        # Force the rollout to ensure the fresh image is pulled
                        kubectl rollout restart deployment fullstack-app -n quantam
                    '''
                }
            }
        }
    }
}